<?xml version="1.0" encoding="UTF-8"?>
<!-- <urlset> es el contenedor principal, con el "xmlns" siendo la referencia oficial al estándar de sitemaps que usan TODOS los buscadores -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

  <!-- Cada <url> representa una página de tu sitio -->
  <url>
    <loc>https://renatacastro19.github.io/CarumaWeb/index.html</loc>          <!-- loc = "location", la URL exacta de la página -->
    <changefreq>monthly</changefreq>                              <!-- Le sugiere a Google qué tan seguido cambia esta página (mensualmente, en este caso) -->
    <priority>1.0</priority>                                        <!-- Prioridad relativa dentro de TU sitio, de 0.0 a 1.0. Inicio es la más importante -->
  </url>
  <url>
    <loc>https://renatacastro19.github.io/CarumaWeb/servicios.html</loc>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>   <!-- Servicios casi tan importante como Inicio, es donde la gente decide qué contratar -->
  </url>
  <url>
    <loc>https://renatacastro19.github.io/CarumaWeb/nosotros.html</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>   <!-- Menor prioridad, es información de apoyo, no la página de conversión principal -->
  </url>
  <url>
    <loc>https://renatacastro19.github.io/CarumaWeb/galeria.html</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>https://renatacastro19.github.io/CarumaWeb/contacto.html</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>   <!-- Alta prioridad, es donde ocurre la conversión (formulario/WhatsApp) -->
  </url>
</urlset>